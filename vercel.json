{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"feat/deployment\" ] && exit 0 || exit 1",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://campusdash-app-92mlo.ondigitalocean.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://campusdash-app-92mlo.ondigitalocean.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
