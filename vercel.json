{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://campusdash-app-92mlo.ondigitalocean.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://campusdash-app-92mlo.ondigitalocean.app/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
